{
  "type": "object",
  "required": ["title", "episodes"],
  "properties": {
    "title": {"type": "string"},
    "logline": {"type": "string"},
    "synopsis": {"type": "string"},
    "episodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "type": "object",
        "required": ["id", "title", "chapters", "synopsis"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9_-]+$"},
          "title": {"type": "string"},
          "chapters": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "synopsis": {"type": "string"},
          "minutes": {"type": "number"},
          "cliffhanger": {"type": "string"}
        }
      }
    }
  }
}
