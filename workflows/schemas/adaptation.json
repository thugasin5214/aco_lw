{
  "type": "object",
  "required": ["logline", "synopsis", "scenes"],
  "properties": {
    "title": {"type": "string"},
    "logline": {"type": "string"},
    "synopsis": {"type": "string"},
    "tone": {"type": "string"},
    "scenes": {
      "type": "array", "minItems": 1, "maxItems": 12,
      "items": {
        "type": "object",
        "required": ["id", "summary", "location", "characters", "beats"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9_-]+$"},
          "summary": {"type": "string"},
          "location": {"type": "string"},
          "characters": {"type": "array", "items": {"type": "string"}},
          "beats": {"type": "array", "items": {"type": "string"}, "minItems": 1},
          "dialogue": {"type": "array", "items": {"type": "object", "required": ["speaker", "line"],
            "properties": {"speaker": {"type": "string"}, "line": {"type": "string"}}}}
        }
      }
    }
  }
}
